WATCH_ASSISTANT_PORT=8115
DATA_DIR=./data
EXTERNAL_NETWORK=pansou_default
COOKIE_SECURE=false
CACHE_WARM_ENABLED=true
CACHE_WARM_TIMEZONE=Asia/Hong_Kong
PANSOU_MAX_CONCURRENCY=6
CACHE_WARM_CONCURRENCY=3
P115_ENABLED=false
P115_COOKIE_PATH=/etc/watch-assistant/p115-cookie
# Required only when P115_ENABLED=true.
P115_TARGET_CID=
P115_MAX_CONCURRENCY=1
# Production 115 organization writes are independently gated and disabled by default.
ORGANIZATION_PLAN_ENABLED=false
ORGANIZATION_EXECUTION_ENABLED=false
ORGANIZATION_WRITE_ENABLED=false
ORGANIZATION_WRITE_CONTRACT_VERIFIED=false
PERMANENT_DELETE_ENABLED=false
PERMANENT_DELETE_CONTRACT_VERIFIED=false
# STRM features are independently gated and disabled by default.
STRM_FULL_ENABLED=false
STRM_INCREMENTAL_ENABLED=false
STRM_CLEANUP_ENABLED=false
STRM_PLAYBACK_ENABLED=false
STRM_PLAYBACK_CONTRACT_VERIFIED=false
STRM_OUTPUT_ROOT=./data/strm
STRM_PLAYBACK_URL_PREFIX=http://127.0.0.1:8115/api/v1/strm/play
# api.tmdb.org is reachable on some networks where api.themoviedb.org is not.
TMDB_BASE_URL=https://api.tmdb.org/3

# Secret file locations. Files contain one value and are mounted read-only.
ENCRYPTION_KEY_FILE=./secrets/encryption_key
TMDB_API_KEY_FILE=./secrets/tmdb_api_key
WEB_PASSWORD_HASH_FILE=./secrets/web_password_hash
SCRIPT_TOKEN_HASH_FILE=./secrets/script_token_hash
