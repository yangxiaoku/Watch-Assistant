WATCH_ASSISTANT_PORT=8115
DATA_DIR=./data
EXTERNAL_NETWORK=pansou_default
COOKIE_SECURE=false
# api.tmdb.org is reachable on some networks where api.themoviedb.org is not.
TMDB_BASE_URL=https://api.tmdb.org/3

# Secret file locations. Files contain one value and are mounted read-only.
ENCRYPTION_KEY_FILE=./secrets/encryption_key
TMDB_API_KEY_FILE=./secrets/tmdb_api_key
WEB_PASSWORD_HASH_FILE=./secrets/web_password_hash
SCRIPT_TOKEN_HASH_FILE=./secrets/script_token_hash
