DATABASE_URL=sqlite+aiosqlite:////var/lib/watch-assistant/watch-assistant.db
ENCRYPTION_KEY=replace-with-fernet-key
TMDB_API_KEY=replace-with-tmdb-api-key
TMDB_BASE_URL=https://api.tmdb.org/3
WEB_PASSWORD_HASH=replace-with-argon2-hash
SCRIPT_TOKEN_HASH=replace-with-argon2-hash
PANSOU_BASE_URL=http://127.0.0.1:8787
TGTO_BASE_URL=http://127.0.0.1:8090
TGTO_CONTRACT_PATH=/opt/watch-assistant/current/config/tgto-contract.json
COOKIE_SECURE=false
CACHE_WARM_ENABLED=true
CACHE_WARM_TIMEZONE=Asia/Hong_Kong
PANSOU_MAX_CONCURRENCY=6
CACHE_WARM_CONCURRENCY=3
